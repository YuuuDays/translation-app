<Window x:Class="TranslationApp.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TranslationApp.Views"
        mc:Ignorable="d"
        Title="Translation App - STT Test" Height="500" Width="620">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" x:Name="StatusText" Text="Whisperモデルを読み込み中..." FontSize="16" Margin="0,0,0,10"/>

        <StackPanel Grid.Row="1" Margin="0,0,0,10">
            <TextBlock Text="保存先フォルダ:" FontWeight="Bold"/>
            <StackPanel Orientation="Horizontal">
                <TextBox x:Name="OutputDirText" Width="330" IsReadOnly="True" Margin="0,0,10,0"/>
                <Button x:Name="BrowseButton" Content="変更..." Width="60" Click="BrowseButton_Click"/>
            </StackPanel>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,10">
            <Button x:Name="StartButton" Content="録音開始" Width="100" Height="30" Margin="0,0,10,0" IsEnabled="False" Click="StartButton_Click"/>
            <Button x:Name="StopButton" Content="録音停止" Width="100" Height="30" Margin="0,0,10,0" IsEnabled="False" Click="StopButton_Click"/>
            <Button x:Name="PauseButton" Content="処理を一時停止" Width="130" Height="30" IsEnabled="False" Click="PauseButton_Click"/>
        </StackPanel>

        <TextBlock Grid.Row="3" Text="文字起こし・翻訳結果:" FontWeight="Bold" Margin="0,0,0,5"/>

        <ListBox Grid.Row="4" x:Name="TranscriptList" FontSize="14">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,2,0,10"/>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</Window>
